{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "tauri-app",
  "version": "0.1.2",
  "identifier": "com.t-kawasaki.tauri-app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Obsidian Quick Entry",
        "width": 600,
        "height": 250,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true
      },
      {
        "label": "settings",
        "title": "Settings - Obsidian Quick Entry",
        "width": 450,
        "height": 500,
        "visible": false,
        "decorations": true,
        "alwaysOnTop": true,
        "url": "index.html#settings"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
